USER_DIR = ..

CXXFLAGS = -Wall -g
CXXFLAGS += -MMD
CPPFLAGS += -I . -I $(USER_DIR)
#CFLAGS += -save-temps

OBJS = $(USER_DIR)/record_table_generic.o $(USER_DIR)/record_table_config.o \
 record_table_operator.o record_table_recorder.o record_table_helper.o

record_table_operator: $(OBJS)
	$(CXX) $(CXXFLAGS) $^ -o $@

.PHONY: clean
clean:
	rm -f *.o *.d $(USER_DIR)/*.o $(USER_DIR)/*.d

# Include the dependency files generated by gcc's MMD option -- see 'Managing Projects with GNU Make'.
# But don't include them if the target is 'clean'.
# -include means don't print an error message if the .d files don't exist.
ifneq "$(MAKECMDGOALS)" "clean"
-include $(subst .o,.d,$(OBJS))
endif
